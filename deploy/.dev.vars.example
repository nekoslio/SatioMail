# SatioMail 本地调试配置模板
# 复制为项目根目录的 .dev.vars 并填入真实值（.dev.vars 已被 .gitignore 排除，不会提交）

# 网页登录密码（自己随意设置）
APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# 会话 Cookie 签名密钥（生成命令：openssl rand -hex 32）
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET

# 企业邮箱地址（完整地址，IMAP/SMTP 登录名）
EMAIL_USERNAME=you@example.com

# 邮箱客户端授权码（不是邮箱登录密码；
# 网易企业邮：设置 → 客户端授权密码；腾讯企业邮：设置 → 客户端设置/安全 → 生成授权码）
EMAIL_PASSWORD=CHANGE_ME_AUTH_CODE

# 多账号配置（可选；JSON 数组字符串，配了则替代 EMAIL_USERNAME/EMAIL_PASSWORD）。
# 每个元素支持字段：id / label / username / password / imapHost / imapPort /
# smtpHost / smtpPort / from（from 可选，省略时等于 username）。
# 部署到生产时请用：npx wrangler secret put ACCOUNTS_CONFIG
# ACCOUNTS_CONFIG='[{"id":"work","label":"工作","username":"you@work.com","password":"AUTH","imapHost":"imap.exmail.qq.com","imapPort":993,"smtpHost":"smtp.exmail.qq.com","smtpPort":465}]'
